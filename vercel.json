{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "python3 dashboard/build_site.py",
  "outputDirectory": "site",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/models.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
