// Santa going down the chimney, for the 600 x 600 mm LED neon sign.
//
// Board: any ESP32 (or an Arduino Nano for a fixed loop). Library: FastLED.
// neon_layout.h is generated by neonsign/make_neon_sign.py and says which LEDs
// belong to which piece of flex, so the artwork can change without touching
// this file.
//
// The loop, 11.2 s:
//   0.0 s  Santa up, waving (mittens flash in turn), winks at 2.5 s
//   4.0 s  only his hat above the rim
//   5.5 s  gone: a light runs down both chimney walls
//   7.0 s  the fire: chimney and bricks flicker
//  10.0 s  his hat again, on the way back up
// The browser preview (preview.html) plays the same timeline.

#include <FastLED.h>
#include "neon_layout.h"

#define DATA_PIN 16            // through a 74AHCT125 level shifter to 5 V
#define MAX_MILLIAMPS 6000     // stay under your supply; FastLED dims to fit
#define BRIGHTNESS 170

const uint32_t T_PEEK = 4000, T_GONE = 5500, T_FIRE = 7000, T_BACK = 10000, CYCLE = 11200;

CRGB leds[NUM_LEDS];

static CRGB colourOf(SegmentId s) { return CRGB(SEGMENTS[s].colour); }

static void fillSeg(SegmentId s, CRGB c) {
  fill_solid(leds + SEGMENTS[s].start, SEGMENTS[s].count, c);
}

static void showGroup(Group g) {
  for (uint8_t s = 0; s < NUM_SEGMENTS; s++)
    if (SEGMENTS[s].group == g) fillSeg((SegmentId)s, colourOf((SegmentId)s));
}

static void stars(uint32_t now) {
  for (uint8_t s = 0; s < NUM_SEGMENTS; s++) {
    if (SEGMENTS[s].group != G_STARS) continue;
    // each star breathes at its own rate, never fully off
    uint8_t level = 90 + scale8(sin8(now / (7 + s % 5) + s * 40), 165);
    fillSeg((SegmentId)s, CRGB(SEGMENTS[s].colour).nscale8_video(level));
  }
}

static void santaUp(uint32_t t) {
  showGroup(G_SANTA_UP);
  bool left = (t / 350) % 2;                       // wave: mittens flash in turn
  leds[SEGMENTS[left ? MITTEN_RIGHT : MITTEN_LEFT].start].nscale8_video(40);
  if (t > 2500 && t < 2800) leds[SEGMENTS[EYE_LEFT].start] = CRGB::Black;   // wink
}

// A bright spot runs from the middle of the rim down both walls.
static void chimneyChase(float progress) {
  const Segment &c = SEGMENTS[CHIMNEY];
  float mid = (c.count - 1) / 2.0f, head = progress * (mid + 3);
  for (uint16_t i = 0; i < c.count; i++) {
    float d = fabsf(i - mid) - head;
    float glow = expf(-d * d / 3.0f);
    leds[c.start + i] = blend(colourOf(CHIMNEY), CRGB(255, 220, 160), (uint8_t)(glow * 255));
  }
}

static void fire(uint32_t now) {
  random16_set_seed(now / 90);     // new flames about 11 times a second, not every frame
  for (SegmentId s : {CHIMNEY, BRICK_1, BRICK_2}) {
    const Segment &seg = SEGMENTS[s];
    for (uint16_t i = 0; i < seg.count; i++)
      leds[seg.start + i] = CRGB(255, random8(40, 110), 0).nscale8_video(random8(150, 255));
  }
}

void setup() {
  FastLED.addLeds<WS2812B, DATA_PIN, GRB>(leds, NUM_LEDS).setCorrection(TypicalLEDStrip);
  FastLED.setMaxPowerInVoltsAndMilliamps(5, MAX_MILLIAMPS);
  FastLED.setBrightness(BRIGHTNESS);
}

void loop() {
  uint32_t now = millis(), t = now % CYCLE;
  FastLED.clear();
  showGroup(G_SCENE);
  stars(now);
  if (t < T_PEEK) santaUp(t);
  else if (t < T_GONE) showGroup(G_SANTA_DOWN);
  else if (t < T_FIRE) chimneyChase((t - T_GONE) / float(T_FIRE - T_GONE));
  else if (t < T_BACK) fire(now);
  else showGroup(G_SANTA_DOWN);
  FastLED.show();
  FastLED.delay(16);
}
